{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/josh-borseth-fp-ai/benedict/main/schemas/config.schema.json",
  "title": "Benedict repository config (.benedict/config.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
