{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/josh-borseth-fp-ai/review/main/schemas/organization.schema.json",
  "title": "Review organization manifest (.review/organization.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "correctness",
              "security"
            ]
          }
        },
        "minimumSeverity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "correctness",
                    "security"
                  ]
                }
              }
            },
            "required": [
              "pattern",
              "skills"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "required": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "correctness",
              "security"
            ]
          }
        },
        "minimumSeverity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
