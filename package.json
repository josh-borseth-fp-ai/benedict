{
  "name": "@forwardpath/benedict",
  "version": "0.1.0",
  "private": true,
  "description": "Benedict, a code review skill and deterministic CLI for coding agents.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-borseth-fp-ai/benedict.git"
  },
  "type": "module",
  "bin": {
    "benedict": "dist/main.js"
  },
  "files": [
    "dist",
    ".agents/skills/benedict",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "benedict": "tsx src/main.ts",
    "schemas": "tsx scripts/write-schemas.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2",
    "picomatch": "4.0.7",
    "skills": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
