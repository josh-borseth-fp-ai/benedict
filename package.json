{
  "name": "review-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first code review runtime for official Codex and Claude Code CLIs.",
  "type": "module",
  "bin": {
    "review": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "review": "tsx src/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@vscode/ripgrep": "1.18.0",
    "effect": "4.0.2",
    "tree-sitter": "0.25.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
